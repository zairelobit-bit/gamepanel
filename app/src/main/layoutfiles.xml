<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_lobby_anime_4k"> <!-- GANTI DENGAN GAMBAR ANIME 4K KAMU -->

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp"
        android:background="@drawable/bg_glass_card"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.5">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="sidetools"
            android:textSize="48sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium"
            android:layout_gravity="center_horizontal"
            android:letterSpacing="0.15"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ultimate Gaming & System Optimizer"
            android:textSize="16sp"
            android:textColor="#E0E0E0"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"/>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:layout_marginTop="32dp">

            <!-- Tombol Tools (Pengganti Tanda +) -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardBackgroundColor="#4DFFFFFF"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                android:onClick="openFloatingTools"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                    <ImageView android:layout_width="36dp" android:layout_height="36dp" android:src="@android:drawable/ic_menu_compass" app:tint="#FFFFFF"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tools" android:textColor="#FFFFFF" android:layout_marginTop="8dp" android:textStyle="bold"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Tombol Music -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardBackgroundColor="#4DFFFFFF"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                android:onClick="openMusicPlayer"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                    <ImageView android:layout_width="36dp" android:layout_height="36dp" android:src="@android:drawable/ic_media_play" app:tint="#FF4081"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Music" android:textColor="#FFFFFF" android:layout_marginTop="8dp" android:textStyle="bold"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Tombol Boost (Konsep Moha Lab) -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                app:cardBackgroundColor="#4DFFFFFF"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                android:onClick="runOptimization"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                    <ImageView android:layout_width="36dp" android:layout_height="36dp" android:src="@android:drawable/ic_popup_sync" app:tint="#00E676"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Boost" android:textColor="#FFFFFF" android:layout_marginTop="8dp" android:textStyle="bold"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </GridLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
